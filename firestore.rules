rules_version = '2';
// Ted's Tab database rules, v4 (Oct 8, 2026).
// v3: anyone in the trip can fix an expense; delete stays with the creator or organizer.
// v4: trip settings are organizer-only (crew may only add stored exchange rates); crew edit only their own crew entry
//     and names nobody has claimed, and can't change anyone's 'Pays for' or days out.
// The 6-letter trip code is the invite: anyone signed in to the app who knows it can open the trip and add to it.
// What these rules add over v1:
//  - Anyone in the trip can fix an expense, but must sign the change (editedBy). Only the person who added it, or the organizer, can delete it (D4, revised Oct 7).
//  - Payments: only the person who recorded one, or the organizer, can delete it; nobody edits them.
//  - Nobody can take over a trip or change who created an expense.
//  - A crew name can only be claimed by the person claiming it, and only the organizer can remove people.
//  - Basic checks on amounts and receipt photo size; anything outside the app's own data is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function tripPath(t) { return /databases/$(database)/documents/trips/$(t); }
    // Organizer = whoever created the trip. "After" version is for batches that create the trip and its contents together.
    function isOrganizer(t) { return get(tripPath(t)).data.createdBy == me(); }
    function isOrganizerAfter(t) { return getAfter(tripPath(t)).data.createdBy == me(); }
    function addedByMe() { return resource.data.get('createdBy', '') == me(); }
    function sameCreator() { return request.resource.data.get('createdBy', '') == resource.data.get('createdBy', ''); }
    function okAmount(a) { return a is number && a >= 0 && a < 10000000; }

    match /trips/{t} {
      allow get: if signedIn();
      allow list: if false;  // trip codes cannot be browsed
      allow create: if signedIn() && request.resource.data.createdBy == me();
      // Trip settings belong to the organizer. The app saves exchange rates it looked up, so crew may touch only that field.
      allow update: if signedIn() && sameCreator() && (resource.data.createdBy == me()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rates']));
      allow delete: if signedIn() && resource.data.createdBy == me();

      match /people/{p} {
        allow read: if signedIn();
        // New people are unclaimed, or claimed by me; the organizer can also bring over a crew from a past trip
        allow create: if signedIn() && (request.resource.data.get('uid', null) == null || request.resource.data.uid == me() || isOrganizerAfter(t));
        // Organizer edits anyone, and can free up a claimed name (uid back to null) when someone reinstalls.
        // Crew edit their own entry or a name nobody has claimed (and may claim it for themselves),
        // but can't change 'Pays for' (weight) or days out, which move money.
        allow update: if signedIn() && (isOrganizer(t) || (
          (resource.data.get('uid', null) == null || resource.data.get('uid', null) == me())
          && (request.resource.data.get('uid', null) == resource.data.get('uid', null)
              || (resource.data.get('uid', null) == null && request.resource.data.get('uid', null) == me()))
          && request.resource.data.get('weight', 1) == resource.data.get('weight', 1)
          && request.resource.data.get('away', []) == resource.data.get('away', [])));
        allow delete: if signedIn() && isOrganizer(t);
      }

      match /expenses/{e} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.createdBy == me() && okAmount(request.resource.data.amount);
        // Anyone in the trip can fix an expense. Someone other than the creator or organizer must sign the change as themselves.
        allow update: if signedIn() && sameCreator() && okAmount(request.resource.data.amount)
          && (addedByMe() || isOrganizer(t) || request.resource.data.get('editedBy', '') == me());
        allow delete: if signedIn() && (addedByMe() || isOrganizer(t));
      }

      match /payments/{x} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.createdBy == me() && okAmount(request.resource.data.amount);
        allow update: if false;
        allow delete: if signedIn() && (addedByMe() || isOrganizer(t));
      }

      match /receipts/{r} {
        allow read: if signedIn();
        allow create, update: if signedIn() && request.resource.data.img is string && request.resource.data.img.size() < 1000000;
        // The receipt goes with its expense: the expense's creator, the organizer, or anyone once the expense is gone
        allow delete: if signedIn() && (isOrganizer(t)
          || !exists(/databases/$(database)/documents/trips/$(t)/expenses/$(r))
          || get(/databases/$(database)/documents/trips/$(t)/expenses/$(r)).data.get('createdBy', '') == me());
      }
    }
  }
}
