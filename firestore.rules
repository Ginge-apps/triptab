rules_version = '2';
// Ted's Tab database rules, v9 (Nov 14, 2026). Review and fixes chat. base: v8
// v9: the database refuses badly formed data instead of leaving that to the app: record ids must be plain letters, digits, dash or
//     underscore; names and notes have length limits; currency is three capital letters; shares, rates and "Pays for" are numbers;
//     dates are YYYY-MM-DD; a receipt is a JPEG picture. Who may read, add, change or delete anything is exactly as in v8.
// v8: adds trips/{t}/requests/{uid} so a crew member whose phone forgot them can ask the organizer to move their name to the new phone. Nothing else changes.
// v7: adds the helpdeskReviews collection, readable and writable only by the help-desk admin, so the Help Desk can save 'reviewed OK' notes on flags. No access to trips, people, expenses, payments or receipts changes.
// v6: adds one help-desk admin (a verified Google sign-in as ted.brownn@gmail.com) who may list all trips, for the read-only Help Desk page (admin.html). Nothing else changes from v5.
// v5: crew edit only their own crew entry; unclaimed names can be claimed but not edited by crew (organizer edits those).
// v3: anyone in the trip can fix an expense; delete stays with the creator or organizer.
// v4: trip settings are organizer-only (crew may only add stored exchange rates); crew edit only their own crew entry
//     and names nobody has claimed, and can't change anyone's 'Pays for' or days out.
// The 6-letter trip code is the invite: anyone signed in to the app who knows it can open the trip and add to it.
// What these rules add over v1:
//  - Anyone in the trip can fix an expense, but must sign the change (editedBy). Only the person who added it, or the organizer, can delete it (D4, revised Oct 7).
//  - Payments: only the person who recorded one, or the organizer, can delete it; nobody edits them.
//  - Nobody can take over a trip or change who created an expense.
//  - A crew name can only be claimed by the person claiming it, and only the organizer can remove people.
//  - Basic checks on amounts and receipt photo size; anything outside the app's own data is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function tripPath(t) { return /databases/$(database)/documents/trips/$(t); }
    // Organizer = whoever created the trip. "After" version is for batches that create the trip and its contents together.
    function isOrganizer(t) { return get(tripPath(t)).data.createdBy == me(); }
    function isOrganizerAfter(t) { return getAfter(tripPath(t)).data.createdBy == me(); }
    function addedByMe() { return resource.data.get('createdBy', '') == me(); }
    function sameCreator() { return request.resource.data.get('createdBy', '') == resource.data.get('createdBy', ''); }
    function okAmount(a) { return a is number && a >= 0 && a < 10000000; }
    // v9 shape checks. Missing fields are fine (older records); a field that is present must be the right kind and size.
    function okId(id) { return id.matches('^[A-Za-z0-9_-]{1,64}$'); }
    function okText(d, k, n) { return d.get(k, '') is string && d.get(k, '').size() <= n; }
    function okCur(d) { return d.get('currency', 'USD') is string && d.get('currency', 'USD').matches('^[A-Z]{3}$'); }
    function okDate(d) { return d.get('date', null) == null || (d.get('date', '') is string && d.get('date', '').matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function okTrip(d) { return okText(d, 'name', 200) && okText(d, 'skin', 30) && okCur(d) && d.get('rates', {}) is map && d.get('rates', {}).size() <= 60; }
    function okPerson(d) { return d.get('name', '') is string && d.get('name', '').size() > 0 && d.get('name', '').size() <= 100
      && okText(d, 'nickname', 80) && okText(d, 'household', 100) && okText(d, 'venmo', 200) && okText(d, 'revolut', 200) && okText(d, 'zelle', 200)
      && okText(d, 'paypal', 200) && okText(d, 'other', 200) && okText(d, 'cards', 40)
      && d.get('color', '#888') is string && d.get('color', '#888').matches('^#[0-9a-fA-F]{3,8}$')
      && d.get('weight', 1) is number && d.get('weight', 1) > 0 && d.get('weight', 1) <= 20 && d.get('away', []) is list && d.get('away', []).size() <= 60; }
    function okExpense(d) { return okText(d, 'description', 300) && okText(d, 'note', 1000) && okText(d, 'category', 40) && okCur(d) && okDate(d)
      && (d.get('rate', null) == null || (d.get('rate', 0) is number && d.get('rate', 0) >= 0))
      && (d.get('paidBy', null) == null || (d.get('paidBy', '') is string && okId(d.get('paidBy', 'x'))))
      && d.get('split', {}) is map && d.get('split', {}).size() <= 80
      && (d.get('payers', null) == null || (d.get('payers', {}) is map && d.get('payers', {}).size() <= 80))
      && (d.get('items', null) == null || (d.get('items', []) is list && d.get('items', []).size() <= 80)); }
    function okPayment(d) { return d.get('from', '') is string && okId(d.get('from', '')) && d.get('to', '') is string && okId(d.get('to', '')) && okDate(d); }
    // Help-desk admin: a verified Google sign-in with this exact email. Anonymous app sign-ins have no email, so they can never match.
    function isAdmin() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com'
      && request.auth.token.email_verified == true && request.auth.token.email == 'ted.brownn@gmail.com'; }

    match /trips/{t} {
      allow get: if signedIn();
      allow list: if isAdmin();  // trip codes cannot be browsed by the crew; only the help-desk admin can list trips
      allow create: if signedIn() && request.resource.data.createdBy == me() && okId(t) && okTrip(request.resource.data);
      // Trip settings belong to the organizer. The app saves exchange rates it looked up, so crew may touch only that field.
      allow update: if signedIn() && sameCreator() && okTrip(request.resource.data) && (resource.data.createdBy == me()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rates']));
      allow delete: if signedIn() && resource.data.createdBy == me();

      match /people/{p} {
        allow read: if signedIn();
        // New people are unclaimed, or claimed by me; the organizer can also bring over a crew from a past trip
        allow create: if signedIn() && okId(p) && okPerson(request.resource.data) && (request.resource.data.get('uid', null) == null || request.resource.data.uid == me() || isOrganizerAfter(t));
        // Organizer edits anyone, and can free up a claimed name (uid back to null) when someone reinstalls.
        // v5: crew edit ONLY their own entry, and never 'Pays for' (weight) or days out, which move money.
        // A name nobody has claimed can only be claimed (uid null -> me, nothing else changed); its details stay with the organizer.
        allow update: if signedIn() && okPerson(request.resource.data) && (isOrganizer(t)
          || (resource.data.get('uid', null) == me()
              && request.resource.data.get('uid', null) == me()
              && request.resource.data.get('weight', 1) == resource.data.get('weight', 1)
              && request.resource.data.get('away', []) == resource.data.get('away', []))
          || (resource.data.get('uid', null) == null
              && request.resource.data.get('uid', null) == me()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])));
        allow delete: if signedIn() && isOrganizer(t);
      }

      match /expenses/{e} {
        allow read: if signedIn();
        allow create: if signedIn() && okId(e) && request.resource.data.createdBy == me() && okAmount(request.resource.data.amount) && okExpense(request.resource.data);
        // Anyone in the trip can fix an expense. Someone other than the creator or organizer must sign the change as themselves.
        allow update: if signedIn() && sameCreator() && okAmount(request.resource.data.amount) && okExpense(request.resource.data)
          && (addedByMe() || isOrganizer(t) || request.resource.data.get('editedBy', '') == me());
        allow delete: if signedIn() && (addedByMe() || isOrganizer(t));
      }

      match /payments/{x} {
        allow read: if signedIn();
        allow create: if signedIn() && okId(x) && request.resource.data.createdBy == me() && okAmount(request.resource.data.amount) && okPayment(request.resource.data);
        allow update: if false;
        allow delete: if signedIn() && (addedByMe() || isOrganizer(t));
      }

      // v8: "get back in on a new phone". The request's id is the asker's own sign-in, so each phone has at most one.
      // Only the asker or the organizer can see or remove it. The asker can't move the name; the organizer does that (people rules above).
      match /requests/{u} {
        allow read: if signedIn() && (u == me() || isOrganizer(t));
        allow create, update: if signedIn() && u == me() && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'pid', 'name', 'at'])
          && request.resource.data.pid is string && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && exists(/databases/$(database)/documents/trips/$(t)/people/$(request.resource.data.pid));
        allow delete: if signedIn() && (u == me() || isOrganizer(t));
      }

      match /receipts/{r} {
        allow read: if signedIn();
        allow create, update: if signedIn() && okId(r) && request.resource.data.img is string && request.resource.data.img.size() < 1000000
          && request.resource.data.img.size() > 23 && request.resource.data.img[0:23] == 'data:image/jpeg;base64,';
        // The receipt goes with its expense: the expense's creator, the organizer, or anyone once the expense is gone
        allow delete: if signedIn() && (isOrganizer(t)
          || !exists(/databases/$(database)/documents/trips/$(t)/expenses/$(r))
          || get(/databases/$(database)/documents/trips/$(t)/expenses/$(r)).data.get('createdBy', '') == me());
      }
    }

    // v7: Help Desk review notes. Nobody but the verified help-desk admin can read or write these.
    match /helpdeskReviews/{r} {
      allow read, write: if isAdmin();
    }
  }
}
